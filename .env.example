# OutreachOS Environment Configuration
# Copy this file to .env or .env.local

# Database (PostgreSQL)
# DATABASE_URL: Pooled connection string used by application runtime (e.g. PgBouncer, Supabase pooled, Neon pooled)
# For serverless environments (Vercel / AWS Lambda), append pooler parameters to avoid connection exhaustion:
# e.g., postgresql://USER:PASSWORD@HOST:PORT/outreachos?schema=public&connection_limit=5&pool_timeout=10&connect_timeout=5
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/outreachos?schema=public"
# DIRECT_URL: Direct, non-pooled connection string used by Prisma CLI for migrations and schema introspection (port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/outreachos?schema=public"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication (Required - Never expose to client)
# Generate via: `openssl rand -base64 32`
AUTH_SECRET="outreachos_dev_secret_key_change_in_production_32chars"
NEXTAUTH_URL="http://localhost:3000"

# Observability & Logging (Optional)
LOG_LEVEL="info" # debug | info | warn | error
LOG_FORMAT="json" # json (production standard) | text (development default)

# AI Provider (mock | gemini | openai)
AI_PROVIDER="mock"

# Google Gemini API Provider (server-side only)
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_MODEL="gemini-3.1-flash-lite"

# OpenAI-compatible API Provider (Optional)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Lead Data Source (Optional - Leave blank for unconfigured stub provider)
LEAD_SOURCE_API_KEY=""
LEAD_SOURCE_PROVIDER_URL="https://api.outreach-lead-provider.internal/v1"
DISCOVERY_DEV_MODE="false" # Set to "true" to enable offline development mock provider

# Brevo Transactional Email Provider (server-side only)
BREVO_API_KEY=""
BREVO_FROM_EMAIL="outreach@yourverifieddomain.com"
BREVO_FROM_NAME="OutreachOS Studio"

# Set true to force the local in-memory DevelopmentEmailProvider
EMAIL_DEV_MODE="false"

# Legacy / Alternative Production Email Provider (Resend / SMTP)
RESEND_API_KEY=""
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="outreach@yourdomain.com"

# Google OAuth (Sign-In & Future Calendar Sync - Server-side only)
# Local development callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
