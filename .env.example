# OutreachOS Environment Configuration
# Copy this file to .env or .env.local

# Database (PostgreSQL)
# DATABASE_URL: Pooled connection string used by application runtime (e.g. PgBouncer, Supabase pooled, Neon pooled)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/outreachos?schema=public"
# DIRECT_URL: Direct, non-pooled connection string used by Prisma CLI for migrations and schema introspection
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/outreachos?schema=public"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication (Required - Never expose to client)
# Generate via: `openssl rand -base64 32`
AUTH_SECRET="outreachos_dev_secret_key_change_in_production_32chars"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider (OpenAI-compatible)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Lead Data Source (Optional for Phase 1 - Leave blank to use stub provider)
LEAD_SOURCE_API_KEY=""
LEAD_SOURCE_PROVIDER_URL=""

# Email Provider (Future Phase - SMTP / Resend / SendGrid)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="outreach@yourdomain.com"

# Google Calendar (Future Phase)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
